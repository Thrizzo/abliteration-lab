# host folder for models/, out/, gguf/, runs/, data/ (hundreds of GB for large models)
WORKSPACE=./workspace
# reverse proxy (basic auth). Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'yourpassword'
CADDY_USER=admin
CADDY_HASH=
BIND_ADDR=0.0.0.0
HTTP_PORT=8080
# optional: Hugging Face token for gated repos
HF_TOKEN=
