# deploy/.env for the Docker stack. Every command runs from the repository's folder: docker compose --env-file deploy/.env ...
# Copy this file once (cp deploy/.env.example deploy/.env): copying it again overwrites your settings and N8N_ENCRYPTION_KEY.

# The compose files every command uses, one list, so that no command leaves one out (a command with fewer files recreates
# the containers without the GPU or without step 4, and stops a running pipeline stage). Paths from the repository's folder.
#   NVIDIA GPU (Docker Desktop, Linux + NVIDIA container toolkit):  deploy/docker-compose.yml;deploy/docker-compose.gpu.yml
#   no GPU (also Rancher Desktop on Windows):                       deploy/docker-compose.yml
#   step 4 "Pentest" (n8n + Qdrant): add                            ;deploy/n8n/docker-compose.n8n.yml
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=deploy/docker-compose.yml;deploy/docker-compose.gpu.yml
# host folder for models/, out/, gguf/, runs/, data/ (hundreds of GB for large models). Create it before the first `up`.
# relative paths are resolved from deploy/ (the compose file's folder); ../workspace is <repo>/workspace. Absolute paths are safest.
# Windows: forward slashes and no double quotes, e.g. WORKSPACE=D:/redteam-workspace (inside double quotes compose turns
# \r, \n, \t, \a of a path into control characters). A folder outside Documents and OneDrive is faster and is not uploaded.
WORKSPACE=../workspace
# optional: host folder for Ollama's model store (default: named volume); the same path rules
# OLLAMA_STORE=./ollama
# reverse proxy (basic auth). Hash: docker run --rm -it caddy:2 caddy hash-password   (asks for the password twice)
# keep the single quotes around it: the hash contains '$' characters that compose would otherwise try to interpolate,
# e.g. CADDY_HASH='$2a$14$...'. Empty, compose stops and points here.
CADDY_USER=admin
CADDY_HASH=
# 127.0.0.1 = this machine only (reach it over SSH tunnel / VPN); 0.0.0.0 = whole LAN - then use TLS, see Caddyfile
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
# optional: Hugging Face token for gated repos (passed to the pipeline through the environment, never written to run.json)
HF_TOKEN=
# optional: the image's PyTorch build. cu128 (default) has kernels for Turing (RTX 20xx, T4) and newer GPUs; Maxwell, Pascal
# and Volta (GTX 9xx/10xx, Titan V, P40, V100) need cu126, which has no RTX 50xx kernels; cpu builds a CPU-only image.
# Takes effect with `up -d --build`.
# TORCH_FLAVOR=cu126
# optional: where the prompt sets come from (Hugging Face id, optional @revision and #column). Empty: the defaults,
# mlabonne/harmful_behaviors and mlabonne/harmless_alpaca. For company use see deploy/k8s/README.md, "Licences for internal company use".
ABL_HARMFUL_DATASET=
ABL_HARMLESS_DATASET=
# e.g. ABL_HARMLESS_DATASET=databricks/databricks-dolly-15k#instruction
# n8n and Qdrant (only with deploy/n8n/docker-compose.n8n.yml, the copilot): a long random key that encrypts the credentials
# n8n saves. Set it once and keep it: with another key n8n refuses to start ("Mismatching encryption keys" in
# `docker compose --env-file deploy/.env logs n8n`). Lost it? Put the old one back, or start n8n afresh with
# `docker volume rm deploy_n8n_data` (its owner account, credentials and workflow go; connect_console.py sets them up again).
# Make one with
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | % { $_.ToString('x2') }) -join ''
#   bash:       openssl rand -hex 32
# N8N_ENCRYPTION_KEY=
# optional, step 4: n8n's port on this machine (default 5678), and the copilot model the console preselects, as
# `docker compose --env-file deploy/.env exec ollama ollama list` names it (step 2 imports each run as <model>-abl)
# N8N_PORT=5679
# COPILOT_OPERATOR_MODEL=glm-edge-4b-chat-abl:latest
