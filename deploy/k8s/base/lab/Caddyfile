# Login in front of the console, inside the console pod. The app listens on 127.0.0.1:8787 only, so every request,
# from the Ingress, a port-forward or another pod, goes through this basic auth. User and bcrypt hash come from the
# Secret "basic-auth" (keys: user, hash), the same hash format as CADDY_HASH in deploy/.env.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	basic_auth {
		{$CADDY_USER} {$CADDY_HASH}
	}
	request_body {
		max_size 50MB
	}
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
