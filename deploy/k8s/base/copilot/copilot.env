# The copilot's ceiling and default judge. One file, two ConfigMaps: copilot-settings (lab-copilot), which n8n's Code
# nodes read, and copilot-scope (lab), with which the console checks the engagement the GUI saves. An engagement can
# narrow the scope and switch auto-run tiers off, never widen them.
# EDIT: your lab's ranges (comma-separated IPv4 addresses, CIDRs, exact host names).
LAB_ALLOWLIST=10.10.10.0/24,192.168.56.0/24
# auto-run tiers; with the Execute node disabled they change only the wording ("auto-run" vs "waiting for your approval")
LAB_AUTORUN_READONLY=false
LAB_AUTORUN_ACTIVE_RECON=false
# the judge when the console names none (a model in the copilot's Ollama; never an abliterated one)
COPILOT_JUDGE_MODEL=qwen3:8b
